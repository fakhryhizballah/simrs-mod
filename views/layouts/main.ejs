<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Aplikasi' %></title>
        <link rel="manifest" href="/manifest.json">
        <meta name="mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="application-name" content="SIMRS" />
        <meta name="apple-mobile-web-app-title" content="SIMRS" />
    <link href="/asset/css/main.css" rel="stylesheet">
     <% if (typeof hrefhead != 'undefined') { %>
        <% hrefhead.forEach(function(item) { %>
            <link href="<%= item %>" rel="stylesheet" />
        <% }); %>
    <% } %>
     <style>
        .loader {
            border: 4px solid rgba(255, 255, 255, 0.2);
            border-top-color: #60a5fa;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            -webkit-animation: spinner 1.5s linear infinite;
            animation: spinner 1.5s linear infinite;
        }
        @keyframes spinner {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="font-sans flex flex-col" style="background-image: url('/asset/img/background.jpeg'); background-attachment: fixed; background-size: cover; background-position: center;">
    <div class="absolute inset-0 from-white-900/90 via-blue-900/20 to-red-900/30 pointer-events-none"></div>
    <div class="relative z-10 flex flex-col from-transparent via-blue-50/5 to-transparent">
        <%- include('../partials/header') %>
        <main class="grow max-w-8xl mx-8 px-4 py-4 ">
            <%- body %>
        </main>
        <%- include('../partials/footer') %>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/asset/js/main.js" type="module"></script>
    <% if (typeof script != 'undefined') { %>
        <% script.forEach(function(item) { %>
            <script type="module" src="<%= item %>"></script>
        <% }); %>
    <% } %>
</body>
</html>