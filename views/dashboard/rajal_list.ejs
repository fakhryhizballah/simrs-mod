                </div>
            </div>
        </div>

         <!-- Filter Pencarian -->
        <div class="glass glass-lg glass-gradient-light p-6 mb-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 md:gap-6 items-end shadow-xl">
            <div class="flex-1 min-w-[150px]">
                <label for="poli-code" class="glass-label text-white/80">Poli Tujuan</label>
                <select id="poli-code" class="w-full glass-input text-gray-900 bg-white/20 mt-2">
                    <option value="">Memuat data poli...</option>
                </select>
            </div>
            <div class="flex-1 min-w-[150px]">
                <label for="dokter-code" class="glass-label text-white/80">Dokter</label>
                <select id="dokter-code" class="w-full glass-input text-gray-900 bg-white/20 mt-2">
                    <option value="">Memuat data dokter...</option>
                </select>
            </div>
            <div class="flex-1 min-w-[150px]">
                <label for="cari-code" class="glass-label text-white/80">Cari Pasien</label>
                <input id="cari-code" type="text" class="w-full glass-input text-gray-900 bg-white/20 mt-2">
                </input>
            </div>
            <div class="flex-1 min-w-[150px]">
                <label for="date-from" class="glass-label text-white/80">Dari Tanggal</label>
                <input type="date" id="date-from" class="w-full glass-input text-gray-900 mt-2">
